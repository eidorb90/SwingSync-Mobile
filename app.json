{
  "expo": {
    "name": "SwingSync",
    "slug": "swing-sync",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swingsync",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "SwingSync needs access to your camera to take photos for your profile and other app features.",
        "NSPhotoLibraryUsageDescription": "SwingSync needs access to your photo library to let you select and upload images.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.eidorb.swingsync"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.eidorb.swingsync"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "BACKEND_URL": "https://api.swing-sync.com",
      "ver" : "1.0.1",
      "router": {},
      "eas": {
        "projectId": "ee3838ec-f372-487a-b19b-c716a644ae77"
      }
    },
    "owner": "eidorb"
  }
}
